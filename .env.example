# ==============================================================================
# Meet & Ride — Environment Configuration
# ==============================================================================

# Supabase Configuration
# Fill these in when connecting to your remote Supabase project.
# If left empty, Meet & Ride automatically runs in persistent local database mode.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# Nuxt Public Supabase
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-publishable-key
